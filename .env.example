# Copiar a .env y rellenar. .env NUNCA se versiona.
# En GitHub Actions estos mismos nombres van como secrets cifrados.

# Meta — obtener con: python3 -c "from src.platforms.meta import discover; discover('TOKEN_USUARIO')"
SDB_PAGE_ID=
SDB_PAGE_TOKEN=
SDB_IG_USER_ID=
META_API_VERSION=v24.0

# Threads (opcional)
SDB_THREADS_USER_ID=
SDB_THREADS_TOKEN=

# Hosting de imágenes — imprescindible: Meta descarga la imagen desde una URL pública
# Backend de hosting: github (por defecto, sin credenciales) o r2
SDB_HOSTING=github

# Solo si SDB_HOSTING=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE=
