# Copiar a .env y rellenar. .env NUNCA se versiona.
# En GitHub Actions estos mismos nombres van como secrets cifrados.

# Token de usuario, SOLO para la configuración inicial. Se usa una vez, desde
# scripts/configurar_secrets.py, y luego puedes borrarlo: no hace falta para
# publicar. .env está en .gitignore, así que no sale de tu máquina.
SDB_USER_TOKEN=

# Meta — los tres de abajo los deja puestos scripts/configurar_secrets.py
# (o, para verlos sin tocar secrets: discover() en src/platforms/meta.py)
SDB_PAGE_ID=
SDB_PAGE_TOKEN=
SDB_IG_USER_ID=
META_API_VERSION=v24.0

# Threads (opcional)
SDB_THREADS_USER_ID=
SDB_THREADS_TOKEN=

# Hosting de imágenes — imprescindible: Meta descarga la imagen desde una URL pública
# Backend de hosting: github (por defecto, sin credenciales) o r2
SDB_HOSTING=github

# Solo si SDB_HOSTING=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE=
